# PostgreSQL ulanish satri
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sirli?schema=public"
# Ulanishlar havzasi hajmi (ixtiyoriy). `npx prisma dev` lokal bazasi uchun 1 qo'ying
# DATABASE_POOL_MAX="1"

# Saytning ochiq manzili (Telegram Mini App uchun HTTPS bo'lishi shart)
APP_URL="http://localhost:3000"

# Telegram bot (@BotFather'dan olinadi)
TELEGRAM_BOT_TOKEN=""
# Bot username (@ belgisisiz) — saytdagi "Telegram bot orqali buyurtma" havolasi uchun
TELEGRAM_BOT_USERNAME=""
# Buyurtma xabarlari boradigan chat ID(lar). Bir nechta bo'lsa vergul bilan: "123456789,-1001234567890"
# Botga /id yozsangiz, chat ID'ingizni qaytaradi.
TELEGRAM_ADMIN_CHAT_ID=""
# Webhook so'rovlarini tekshirish uchun maxfiy satr (A-Z, a-z, 0-9, _ va -)
TELEGRAM_WEBHOOK_SECRET="change-this-webhook-secret"

# Admin panel
ADMIN_PASSWORD="change-me"
# Kamida 32 belgili tasodifiy satr: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Yuklangan mahsulot rasmlari saqlanadigan papka (Vercel'da BLOB_READ_WRITE_TOKEN bo'lsa Blob ishlatiladi)
UPLOAD_DIR="./uploads"

# Vercel Cron (/api/cron/cleanup) so'rovlarini tekshirish uchun maxfiy satr
CRON_SECRET=""

# Faqat lokal "prisma migrate dev" uchun: alohida bo'sh baza (npx prisma dev beradi)
# SHADOW_DATABASE_URL=""
